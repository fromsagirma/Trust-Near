# ============================================================
# TrustNear Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# PostgreSQL connection string (with PostGIS extension enabled)
# Used by prisma.config.ts (Prisma v7) for Migrate and Client
DATABASE_URL="postgresql://user:password@localhost:5432/trust_near?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — Allowed client origins
USER_APP_URL="http://localhost:3000"
WEB_APP_URL="http://localhost:5173"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="trust_near"

