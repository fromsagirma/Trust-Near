{
  "name": "trustnear-backend",
  "version": "1.0.0",
  "description": "Unified Core & Platform Backend for TrustNear",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/seed.ts",
    "db:seed:docker": "node dist/seed.js",
    "db:studio": "prisma studio",
    "test": "npx ts-node src/__tests__/security_qa.test.ts",
    "test:businesses": "ts-node src/modules/businesses/__tests__/run-business-tests.ts",
    "test:nearby": "ts-node src/modules/businesses/__tests__/run-nearby-tests.ts",
    "test:search": "ts-node src/modules/businesses/__tests__/run-search-tests.ts",
    "test:details": "ts-node src/modules/businesses/__tests__/run-details-tests.ts",
    "test:admin": "ts-node src/modules/admin/__tests__/run-admin-tests.ts",
    "test:moderation": "ts-node src/modules/moderation/__tests__/run-moderation-tests.ts",
    "test:upload": "ts-node src/modules/upload/__tests__/run-upload-tests.ts",
    "test:owner": "ts-node src/modules/owner/__tests__/run-owner-tests.ts",
    "test:reviews": "ts-node src/modules/reviews/__tests__/run-reviews-tests.ts",
    "test:claims": "ts-node src/modules/claims/__tests__/run-claim-tests.ts",
    "test:verified": "ts-node src/modules/reviews/__tests__/run-verified-visit-tests.ts",
    "test:notifications": "ts-node src/modules/notifications/__tests__/run-notifications-tests.ts",
    "test:analytics": "ts-node src/modules/analytics/__tests__/run-analytics-tests.ts",
    "test:promotions": "ts-node src/modules/promotions/__tests__/run-promotions-tests.ts",
    "test:discovery": "ts-node src/modules/discovery/__tests__/run-discovery-tests.ts",
    "test:photos": "ts-node src/modules/photos/__tests__/run-business-photo-tests.ts",
    "test:favorites": "ts-node src/modules/favorites/__tests__/run-favorites-tests.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.0",
    "prisma": "^7.9.1",
    "typescript": "^5.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "strip-bom": "^4.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
