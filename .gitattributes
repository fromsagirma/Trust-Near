# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.dart text eol=lf
*.prisma text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.puml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Configuration & shell
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.keystore binary
*.jks binary
