actor "Business Owner" as owner
actor "Admin" as admin
actor "System / AI" as system

rectangle "TrustNear System (Rev. 2 Use Cases)" {
  usecase "UC-001 Register and log in" as UC1
  usecase "UC-002 Manage profile and delete account" as UC2
  usecase "UC-003 Search for nearby businesses" as UC3
  usecase "UC-004 Search by name or filter by category" as UC4
  usecase "UC-005 Save and remove favorites" as UC5
  usecase "UC-006 Create a business listing" as UC6
  usecase "UC-007 Describe a location by landmark" as UC7
  usecase "UC-008 View business details" as UC8
  usecase "UC-009 Manage listing from owner dashboard" as UC9
  usecase "UC-010 Claim an existing business listing" as UC10
  usecase "UC-011 Discover Google-sourced listings" as UC11
  usecase "UC-012 Rate and review a business" as UC12
  usecase "UC-013 Report and moderate a review" as UC13
  usecase "UC-014 Earn a verified visit badge" as UC14
  usecase "UC-015 Build a connection network" as UC15
  usecase "UC-016 Share a place via in-app chat" as UC16
  usecase "UC-017 Purchase promoted placement" as UC17
  usecase "UC-018 Switch interface language" as UC18
  usecase "UC-019 Browse on low-bandwidth connection" as UC19
  usecase "UC-020 Receive notifications" as UC20
  usecase "UC-021 Moderate flagged content" as UC21
  usecase "UC-022 Approve business listings and claims" as UC22
  usecase "UC-023 View platform analytics" as UC23
